PORT=8787
HOST=127.0.0.1
# Deployment keeps the backend private; Caddy -> frontend -> backend.
TRUST_PROXY=loopback
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8788
FRONTEND_API_ORIGIN=http://127.0.0.1:8787
# Set only to the actual Caddy network CIDR in a server deployment.
FRONTEND_TRUST_PROXY=
# Production: create a restricted app role, enable TLS, and do not expose port 5432.
DATABASE_URL=postgresql://seatraces:CHANGE_ME@db:5432/seatraces
NODE_ENV=production
# Email binding/password recovery. Keep empty until a sender is configured.
# Production origin must use HTTPS; local testing may use http://127.0.0.1:8788.
APP_ORIGIN=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
AMAP_KEY=
# v5 preserves the existing POI 2.0 integration. Check account permissions first.
# Set v3 explicitly if the account only supports basic POI search; no auto retry.
AMAP_POI_VERSION=v5
# JS API public application key + server-only security code; separate from Web service key.
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
# Optional overseas adapter. Keep none until account, billing and quotas are ready.
OVERSEAS_MAP_PROVIDER=none
# Restrict this server key to Routes API + Places API (New) and the server IP.
GOOGLE_MAPS_SERVER_KEY=
# Separate public browser key, restricted to Maps JavaScript API + HTTP referrers.
GOOGLE_MAPS_JS_KEY=
# Conservative local reservation estimate per server request, not a vendor bill.
GOOGLE_REQUEST_RESERVE_CNY=0.50
# Server-local read gateway; use an SSH tunnel for local prototype development.
OSM_SERVICE_URL=http://127.0.0.1:8791
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Local CPU Chinese BGE q8 model, prepared separately; no embedding API bill.
EMBEDDING_ENABLED=false
JUHE_TRAIN_KEY=
# Flight integration uses Amadeus Flight Offers Search. Production credentials required.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_PRODUCTION=false
API_MONTHLY_BUDGET_CNY=200
API_DAILY_REQUEST_LIMIT=400
AMAP_DAILY_REQUEST_LIMIT=300
# Hierarchy batches have no application count cap; the monthly budget still applies.
AMAP_PARENT_LOOKUP_ENABLED=false
# Offline scenic hierarchy runs never call Amap. Optional evidence extraction
# reserves at most this amount per unchanged five-city source batch.
HIERARCHY_MODEL_BUDGET_CNY=5
# Full pending-place DeepSeek triage: suggestions only, never automatic confirmation.
# Shared monthly budget applies; this offline batch has a separate request counter.
HIERARCHY_ASSESSMENT_BUDGET_CNY=20
# Display grouping uses validated DeepSeek suggestions backed by OSM containment.
# Set false to hide suggested relations; raw records and confirmed parents remain.
SCENIC_MODEL_GROUPING_ENABLED=true
# Optional absolute Python interpreter path with osmium + shapely installed.
OSM_PYTHON=
# Public basic-search list price: 30 CNY / 10,000 calls (checked 2026-10-12).
# This reserve is an estimate; account packages/free quota determine real charges.
AMAP_PARENT_REQUEST_RESERVE_CNY=0.003
DEEPSEEK_DAILY_REQUEST_LIMIT=50
QWEATHER_API_HOST=
QWEATHER_API_KEY=
QWEATHER_DAILY_REQUEST_LIMIT=50
GOOGLE_DAILY_REQUEST_LIMIT=30
# A monthly manual reserve for vendor requests; an estimate, not vendor billing.
API_REQUEST_RESERVE_CNY=0.10
ADMIN_USERNAME=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
